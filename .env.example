# Copy to .env and fill in. Never commit .env.

# MikroTik: use a dedicated READ-ONLY user (group "read"), restricted to this machine's address.
MK_HOST=172.17.1.1
MK_USER=
MK_PASS=
# MK_PORT=8728
# MK_USE_SSL=false          # set true (and MK_PORT=8729) once api-ssl is enabled on the router

# V-SOL OLTs (comma separated)
OLTS=172.30.49.11,172.30.49.12
OLT_USER=
OLT_PASS=
# PON_PORTS=0/1             # add more if an OLT has other PON ports, e.g. 0/1,0/2

# Collection
# INTERVAL_S=60
# OLT_CMD_WAIT_S=3
# OLT_CONNECT_TIMEOUT_S=10

# Storage (defaults shown)
# DB_PATH=data/isp_telemetry.db
# LOG_DIR=logs
# RETENTION_INTERFACE_DAYS=90
# RETENTION_LOG_DAYS=180

# Alert thresholds
# RX_WARN_DBM=-24
# RX_CRIT_DBM=-25
# CPU_ALERT_PCT=80
# COLLECTOR_STALE_S=180
# MASS_DROP_MIN_ONUS=5
